{
    "files.associations": {
      "*.asm": "gbz80",
      "*.inc": "rgbds-z80",
      "*.s": "rgbds-z80"
    },
    "editor.tabSize": 8,
    "editor.insertSpaces": false,
    "workbench.colorCustomizations": {
        "titleBar.activeBackground": "#2d93ce",
	"titleBar.inactiveBackground": "#1d5d83",
	"titleBar.activeForeground": "#FFFFFF"
    },
    "rgbds-z80.includePaths": [
        "${workspaceFolder}",
        "${workspaceFolder}/constants",
        "${workspaceFolder}/macros"
    ],
    "emulicious-debugger.port": 58870,
    "emulicious-debugger.launch.emuliciousPath": ""
}