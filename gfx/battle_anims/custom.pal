; water
	RGB 31, 31, 31
	RGB 00, 19, 28
	RGB 08, 09, 28
	RGB 00, 00, 00
; hp_fighting
	RGB 31, 31, 31
	RGB 31, 15, 00
	RGB 19, 00, 00
	RGB 00, 00, 00
